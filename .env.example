##################################################
# Database Configuration
##################################################

DB_HOST=localhost
DB_PORT=5432
DB_NAME=prompt_manager
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-postgres-password


##################################################
# Prompt Service
##################################################

PROMPT_SERVICE_PORT=8081
PROMPT_SERVICE_URL=http://localhost:8081
SERVER_PORT=8081


##################################################
# Review Service
##################################################

REVIEW_SERVICE_PORT=8082
REVIEW_SERVICE_URL=http://localhost:8082
REVIEW_STORAGE_FILE=reviews.json


##################################################
# Frontend
##################################################

FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

VITE_API_URL=http://localhost:8081
VITE_REVIEW_API_URL=http://localhost:8082


##################################################
# Nginx
##################################################

NGINX_PORT=80
NGINX_SECURE_PORT=443


##################################################
# General Environment
##################################################

ENVIRONMENT=development
LOG_LEVEL=debug


##################################################
# JWT Authentication
##################################################

JWT_SECRET=replace-with-a-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000

AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-login-password


##################################################
# Cloudinary
##################################################

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret


##################################################
# Review Digest Scheduling
##################################################

DIGEST_INTERVAL_MS=30000
DIGEST_INITIAL_DELAY_MS=5000


##################################################
# Async Review Notification
##################################################

NOTIFICATION_LOG_FILE=notifications.log
NOTIFICATION_DELAY_MS=3000
